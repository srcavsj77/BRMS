# Arquivo de exemplo de variáveis de ambiente
# Copie este arquivo para .env e preencha os valores para o seu ambiente local.
# NUNCA versione o arquivo .env real no repositório.

# === Configuração da API ===
PORT=3333
NODE_ENV=development

# === Configuração de Segurança ===
# Uma string segura de 32 a 64 caracteres. Use ferramentas como `openssl rand -hex 32` para gerar
JWT_SECRET=super_secret_key_change_in_production

# === Configuração de CORS ===
# Defina origens permitidas (ex: http://localhost:5173 para frontend vite local)
CORS_ORIGIN=http://localhost:5173

# === Configuração de Banco de Dados ===
# Em um ambiente real, configure as credenciais do banco
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=admin
# DB_PASS=secret
# DB_NAME=brms

# === Configurações de Monitoramento (Exemplos) ===
# LOG_LEVEL=info
# SENTRY_DSN=
# NEW_RELIC_LICENSE_KEY=
