# --- Build Stage ---
FROM node:20-alpine AS builder

WORKDIR /app

# Instalar dependências (aproveitar cache de camadas)
COPY package.json package-lock.json ./
RUN npm ci

# Copiar código-fonte
COPY . .

# Construir a aplicação Vite para produção
RUN npm run build

# --- Production Stage (NGINX) ---
FROM nginx:alpine

# Copiar os arquivos compilados do build stage para o Nginx
COPY --from=builder /app/dist /usr/share/nginx/html

# Opcional: Adicionar configuração personalizada do Nginx para lidar com rotas de SPA
# COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Executar Nginx como usuário não root quando possível (depende da configuração)
CMD ["nginx", "-g", "daemon off;"]
